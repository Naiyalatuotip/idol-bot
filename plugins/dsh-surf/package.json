{
  "name": "dsh-surf",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "QQ 接入（OneBot v11 WebSocket，NapCat/SnowLuma/Lagrange）+ 微博阅读（账号 cookies 只读关注/推荐，按兴趣排序，可在对话里分享）。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
